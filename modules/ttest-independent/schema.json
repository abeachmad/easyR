    { "id": "normalityTest", "label": "Shapiro-Wilk normality test", "type": "checkbox", "default": false, "group": "Diagnostics" },
    { "id": "effectSize", "label": "Cohen's d", "type": "checkbox", "default": false, "group": "Diagnostics" },
    { "id": "plotDescriptives", "label": "Mean with confidence interval plot", "type": "checkbox", "default": false, "group": "Plots" }
